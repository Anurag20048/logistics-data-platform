FROM apache/airflow:2.10.4-python3.11

USER airflow
COPY requirements-data-stack.txt /tmp/requirements-data-stack.txt
RUN pip install --no-cache-dir \
    "dbt-core>=1.8,<2" \
    "dbt-postgres>=1.8,<2" \
    "pandas>=2.0,<3" \
    "numpy>=1.24,<3" \
    "psycopg2-binary>=2.9" \
    "kafka-python>=2.0" \
    "boto3>=1.34"
